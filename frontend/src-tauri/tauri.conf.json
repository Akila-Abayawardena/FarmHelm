{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FarmHelm",
  "version": "0.1.0",
  "identifier": "com.farmhelm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "beforeBuildCommand": "npm run desktop:prepare && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FarmHelm",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/farmhelm-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
